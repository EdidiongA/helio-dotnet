<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Helio.NET HTTP API and web console.</Description>
    <UserSecretsId>helio-dotnet-api</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Helio.Infrastructure/Helio.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Development settings (anonymous reads, a placeholder key) must never ride along in a published image. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Helio.UnitTests" />
    <InternalsVisibleTo Include="Helio.IntegrationTests" />
  </ItemGroup>
</Project>
