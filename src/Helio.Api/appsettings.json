{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*",
  "Rag": {
    "TopK": 4,
    "CandidateK": 12,
    "MinRelativeScore": 0.25,
    "MaxQuestionChars": 1000,
    "PromptVersion": "helio-grounded-v4",
    "AnswerCacheTtl": "00:10:00",
    "GenerationTimeout": "00:00:45",
    "MaxEvaluationCasesPerRequest": 50
  },
  "Ai": {
    "Provider": "deterministic",
    "Endpoint": "",
    "ApiKey": "",
    "ChatDeployment": "gpt-4o-mini",
    "EmbeddingDeployment": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "Prices": {
      "gpt-4o-mini": "0.15/0.60",
      "gpt-4o": "2.50/10.00",
      "text-embedding-3-small": "0.02/0",
      "extractive-v3": "0/0",
      "hashing-512": "0/0"
    }
  },
  "Storage": {
    "Database": "sqlite",
    "ConnectionString": "Data Source=data/helio.db",
    "VectorStore": "memory",
    "SearchEndpoint": "",
    "SearchApiKey": "",
    "SearchIndexName": "helio-chunks",
    "RedisConnectionString": "",
    "MemoryCacheSizeLimitEntries": 10000
  },
  "Retention": {
    "QueryRecordRetention": "00:00:00",
    "PurgeInterval": "01:00:00"
  },
  "Proxy": {
    "TrustedNetworks": []
  },
  "Security": {
    "ReaderApiKeys": [],
    "OperatorApiKeys": [],
    "AllowAnonymousReads": false,
    "JwtAuthority": "",
    "JwtAudience": "",
    "JwtReaderRole": "Helio.Reader",
    "JwtOperatorRole": "Helio.Operator",
    "CallerHashPepper": "",
    "AskPermitPerMinute": 60,
    "IngestPermitPerMinute": 10,
    "EvaluateCasesPerTenMinutes": 200,
    "UnauthenticatedPermitPerMinute": 30
  }
}
